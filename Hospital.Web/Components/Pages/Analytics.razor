@page "/analytics"
@using Hospital.Application.Contracts.Doctors
@using Hospital.Application.Contracts.Patients
@using Hospital.Application.Contracts.Appointments
@inject HospitalApiClient Api
@attribute [StreamRendering]

<PageTitle>Аналитика (Analytics)</PageTitle>

<h1>Больничная аналитика</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">❌ Ошибка загрузки данных (Error)</h4>
            <p>@errorMessage</p>
            <hr>
            <p class="mb-0">Пожалуйста, убедитесь, что сервер API запущен (Please check API server).</p>
        </div>
}
else if (isLoading)
{
                <div class="alert alert-info">Загрузка статистики...</div>
}
else
{
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                Опытные врачи (>10 лет)
                            </div>
                            <div class="card-body">
                                <ul>
                        @foreach (var doc in experiencedDoctors)
                        {
                                                <li><strong>@doc.FullName</strong> (@doc.ExperienceYears лет)</li>
                        }
                        @if (experiencedDoctors.Count == 0)
                        {
                                            <li>Нет данных</li>
                        }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                Повторные приемы (за месяц)
                            </div>
                            <div class="card-body text-center">
                                <h2 class="display-4">@followUpsCount</h2>
                                <p>пациентов вернулись на повторный осмотр</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-4">
                        <div class="card">
                            <div class="card-header bg-warning text-dark">
                                 Пациенты >30 лет (посетили 2+ врачей)
                            </div>
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr><th>Имя</th><th>Возраст</th><th>Телефон</th></tr>
                                </thead>
                                <tbody>
                        @foreach (var p in complexPatients)
                        {
                                                    <tr>
                                                        <td>@p.FullName</td>
                                                        <td>@(DateTime.Now.Year - p.BirthDate.Year)</td>
                                                        <td>@p.Phone</td>
                                                    </tr>
                        }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                         Расписание кабинета 101 (Текущий месяц)
                    </div>
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr><th>Время</th><th>Врач ID</th><th>Пациент ID</th></tr>
                        </thead>
                        <tbody>
                @foreach (var appt in roomSchedule)
                {
                                            <tr>
                                                <td>@appt.StartAt</td>
                                                <td>@appt.DoctorId</td>
                                                <td>@appt.PatientId</td>
                                            </tr>
                }
                        </tbody>
                    </table>
                </div>
}

@code {
    private List<DoctorDto> experiencedDoctors = [];
    private List<PatientDto> complexPatients = [];
    private List<AppointmentDto> roomSchedule = [];
    private int followUpsCount = 0;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var t1 = Api.GetExperiencedDoctorsAsync();
            var t2 = Api.GetFollowUpsCountAsync();
            var t3 = Api.GetComplexPatientsAsync();
            var t4 = Api.GetRoomScheduleAsync("101"); 

            await Task.WhenAll(t1, t2, t3, t4);

            experiencedDoctors = t1.Result;
            followUpsCount = t2.Result;
            complexPatients = t3.Result;
            roomSchedule = t4.Result;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось получить данные: {ex.Message}";
            Console.WriteLine($"Error fetching analytics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}