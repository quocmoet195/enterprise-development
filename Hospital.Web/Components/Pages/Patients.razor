@page "/patients"
@using Hospital.Application.Contracts.Patients
@using Hospital.Domain.Enums
@using System.ComponentModel.DataAnnotations
@inject HospitalApiClient Api

@rendermode InteractiveServer
@attribute [StreamRendering]

<PageTitle>Управление пациентами (Patients)</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Список пациентов</h1>
        <button class="btn btn-success shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-person-plus-fill"></i> Добавить пациента
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
            <div class="alert alert-danger alert-dismissible fade show">
                <strong>Ошибка:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
    }

    @if (isLoading)
    {
            <div class="alert alert-info">
                <div class="spinner-border spinner-border-sm me-2"></div> Загрузка данных...
            </div>
    }
    else
    {
            <div class="table-scroll-container">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-success sticky-top">
                        <tr>
                            <th>ФИО</th>
                            <th>Телефон</th>
                            <th>Пол</th>
                            <th>Дата рожд.</th>
                            <th>Группа крови</th>
                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in patients)
                    {
                                <tr>
                                    <td><strong>@p.FullName</strong></td>
                                    <td>@p.Phone</td>
                                    <td>@p.Gender</td> 
                                    <td>@p.BirthDate.ToShortDateString()</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                    @p.BloodGroup (@p.Rhesus)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(p)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePatient(p.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-muted small">Всего пациентов: @patients.Count</div>
    }
</div>

@if (showModal)
{
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditMode ? "Редактировать пациента" : "Новый пациент")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Паспорт</label>
                                            <InputText class="form-control" @bind-Value="formModel.Passport" placeholder="повторно вставьте данные в паспорт..." />
                                        <ValidationMessage For="() => formModel.Passport" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">ФИО</label>
                                        <InputText class="form-control" @bind-Value="formModel.FullName" />
                                        <ValidationMessage For="() => formModel.FullName" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Пол</label>
                                        <InputSelect class="form-select" @bind-Value="formModel.Gender">
                                        @foreach (var g in Enum.GetValues<Gender>())
                                        {
                                                    <option value="@g">@g</option>
                                        }
                                        </InputSelect>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Дата рождения</label>
                                        <InputDate class="form-control" @bind-Value="formModel.BirthDate" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Адрес</label>
                                        <InputText class="form-control" @bind-Value="formModel.Address" />
                                        <ValidationMessage For="() => formModel.Address" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Телефон</label>
                                        <InputText class="form-control" @bind-Value="formModel.Phone" />
                                        <ValidationMessage For="() => formModel.Phone" />
                                    </div>

                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Группа крови</label>
                                            <InputSelect class="form-select" @bind-Value="formModel.BloodGroup">
                                            @foreach (var bg in Enum.GetValues<BloodGroup>())
                                            {
                                                        <option value="@bg">@bg</option>
                                            }
                                            </InputSelect>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="form-label">Резус</label>
                                            <InputSelect class="form-select" @bind-Value="formModel.Rhesus">
                                            @foreach (var rh in Enum.GetValues<RhesusFactor>())
                                            {
                                                        <option value="@rh">@rh</option>
                                            }
                                            </InputSelect>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Сохранить</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
}

@code {
    private List<PatientDto> patients = [];
    private bool isLoading = true;
    private string? errorMessage;

    private bool showModal = false;
    private bool isEditMode = false;
    private int editingId = 0;

    public class PatientFormModel
    {
        [Required] public string Passport { get; set; } = "";
        [Required] public string FullName { get; set; } = "";
        [Required] public Gender Gender { get; set; } = Gender.Male;
        [Required] public DateOnly BirthDate { get; set; } = new DateOnly(1990, 1, 1);
        [Required] public string Address { get; set; } = "";
        [Required] public BloodGroup BloodGroup { get; set; } = BloodGroup.O;
        [Required] public RhesusFactor Rhesus { get; set; } = RhesusFactor.Positive;
        [Required] public string Phone { get; set; } = "";
    }

    private PatientFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            patients = await Api.GetPatientsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally { isLoading = false; }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        formModel = new PatientFormModel();
        showModal = true;
    }

    private void OpenEditModal(PatientDto p)
    {
        isEditMode = true;
        editingId = p.Id;

        var gender = Enum.TryParse<Gender>(p.Gender, true, out var g) ? g : Gender.Male;
        var bloodGroup = Enum.TryParse<BloodGroup>(p.BloodGroup, true, out var bg) ? bg : BloodGroup.O;
        var rhesus = Enum.TryParse<RhesusFactor>(p.Rhesus, true, out var rh) ? rh : RhesusFactor.Positive;

        formModel = new PatientFormModel
            {
                Passport = "",
                FullName = p.FullName,
                Gender = gender,
                BirthDate = p.BirthDate,
                Address = p.Address,
                BloodGroup = bloodGroup,
                Rhesus = rhesus,
                Phone = p.Phone
            };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        try
        {
            var dtoToSend = new PatientCreateUpdateDto(
                formModel.Passport,
                formModel.FullName,
                formModel.Gender,
                formModel.BirthDate,
                formModel.Address,
                formModel.BloodGroup,
                formModel.Rhesus,
                formModel.Phone
            );

            bool success;
            if (isEditMode)
            {
                success = await Api.UpdatePatientAsync(editingId, dtoToSend);
            }
            else
            {
                success = await Api.CreatePatientAsync(dtoToSend);
            }

            if (success)
            {
                showModal = false;
                await LoadData();
            }
            else
            {
                errorMessage = "Не удалось сохранить (API error).";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
    }

    private async Task DeletePatient(int id)
    {
        try
        {
            var success = await Api.DeletePatientAsync(id);
            if (success) await LoadData();
            else errorMessage = "Не удалось удалить.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления: {ex.Message}";
        }
    }
}