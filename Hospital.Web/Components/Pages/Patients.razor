@page "/patients"
@using Hospital.Application.Contracts.Patients
@inject HospitalApiClient Api
@attribute [StreamRendering]

<PageTitle>Список пациентов</PageTitle>

<h1 class="mb-4">Список пациентов</h1>

@if (isLoading)
{
            <div class="alert alert-info">Загрузка данных из API....</div>
}
else
{
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-success">
                <tr>
                    <th>ID</th>
                    <th>Полное имя</th>
                    <th>Группа крови</th>
                    <th>Номер телефона</th>
                </tr>
            </thead>
            <tbody>
            @if (patients != null)
            {
                @foreach (var p in patients)
                {
                                <tr>
                                    <td>@p.Id</td>
                                    <td>@p.FullName</td>
                                    <td>@p.BloodGroup</td> 
                                    <td>@p.Phone</td>
                                </tr>
                }
            }
            </tbody>
        </table>
}

@code {
    private List<PatientDto>? patients;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            patients = await Api.GetPatientsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }
}