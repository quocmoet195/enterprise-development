@page "/doctors"
@using Hospital.Application.Contracts.Doctors
@using Hospital.Domain.Enums
@using System.ComponentModel.DataAnnotations
@inject HospitalApiClient Api
@rendermode InteractiveServer 
@attribute [StreamRendering]

<PageTitle>Управление врачами</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Список врачей</h1>
        <button class="btn btn-primary shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-circle"></i> Добавить врача
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Ошибка:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
    }

    @if (isLoading)
    {
            <div class="alert alert-info">
                <div class="spinner-border spinner-border-sm me-2"></div> Загрузка данных...
            </div>
    }
    else
    {
            <div class="table-scroll-container">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-primary sticky-top">
                        <tr>
                            <th>ID</th>
                            <th>ФИО</th>
                            <th>Специализация</th>
                            <th>Опыт (лет)</th>
                            <th style="width: 120px;" class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var doc in doctors)
                    {
                                <tr>
                                    <td>@doc.Id</td>
                                    <td><strong>@doc.FullName</strong></td>
                                    <td><span class="badge bg-info text-dark">@doc.Specialization</span></td>
                                    <td>@doc.ExperienceYears лет</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(doc)" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDoctor(doc.Id)" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-muted small">Всего врачей: @doctors.Count</div>
    }
</div>

@if (showModal)
{
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditMode ? "Редактировать врача" : "Новый врач")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>

                    <div class="modal-body">
                        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">ФИО</label>
                                <InputText class="form-control" @bind-Value="formModel.FullName" placeholder="Например: Иван Иванов" />
                                <ValidationMessage For="() => formModel.FullName" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Специализация</label>
                                <InputSelect class="form-select" @bind-Value="formModel.Specialization">
                                @foreach (var spec in Enum.GetValues<DoctorSpecialization>())
                                {
                                            <option value="@spec.ToString()">@spec</option>
                                }
                                </InputSelect>
                            </div>

                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label">Год рождения</label>
                                    <InputNumber class="form-control" @bind-Value="formModel.BirthYear" />
                                    <ValidationMessage For="() => formModel.BirthYear" />
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label">Опыт работы (лет)</label>
                                    <InputNumber class="form-control" @bind-Value="formModel.ExperienceYears" />
                                    <ValidationMessage For="() => formModel.ExperienceYears" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Сохранить</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
}

@code {
    private List<DoctorDto> doctors = [];
    private bool isLoading = true;
    private string? errorMessage;

    private bool showModal = false;
    private bool isEditMode = false;
    private int editingId = 0;

    public class DoctorFormModel
    {
        [Required(ErrorMessage = "Введите ФИО")]
        public string FullName { get; set; } = "";

        [Required]
        public string Specialization { get; set; } = "Therapist";

        [Range(1900, 2100, ErrorMessage = "Некорректный год рождения")]
        public int BirthYear { get; set; } = 1980;

        [Range(0, 80, ErrorMessage = "Опыт должен быть от 0 до 80 лет")]
        public int ExperienceYears { get; set; } = 0;
    }

    private DoctorFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            doctors = await Api.GetDoctorsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить данные: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        formModel = new DoctorFormModel();
        showModal = true;
    }

    private void OpenEditModal(DoctorDto doc)
    {
        isEditMode = true;
        editingId = doc.Id;

        formModel = new DoctorFormModel
            {
                FullName = doc.FullName,
                Specialization = doc.Specialization,
                ExperienceYears = doc.ExperienceYears,
                BirthYear = 1980
            };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        try
        {
            var dtoToSend = new DoctorCreateUpdateDto(
                formModel.FullName,
                formModel.BirthYear,
                formModel.ExperienceYears,
                formModel.Specialization
            );

            bool success;
            if (isEditMode)
            {
                success = await Api.UpdateDoctorAsync(editingId, dtoToSend);
            }
            else
            {
                success = await Api.CreateDoctorAsync(dtoToSend);
            }

            if (success)
            {
                showModal = false;
                await LoadData();
            }
            else
            {
                errorMessage = "Ошибка API. Не удалось сохранить данные.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при сохранении: {ex.Message}";
        }
    }

    private async Task DeleteDoctor(int id)
    {
        try
        {
            var success = await Api.DeleteDoctorAsync(id);
            if (success) await LoadData();
            else errorMessage = "Невозможно удалить врача (возможно, есть записи на прием).";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления: {ex.Message}";
        }
    }
}