@page "/"
@using Hospital.Application.Contracts.Doctors
@using Hospital.Application.Contracts.Patients
@using Hospital.Application.Contracts.Appointments
@inject HospitalApiClient Api
@attribute [StreamRendering]

<PageTitle>Hospital Dashboard</PageTitle>

<div class="container-fluid mt-3">
    <h1 class="mb-4">Панель управления</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
            <div class="alert alert-danger shadow-sm">
                <h4 class="alert-heading">Ошибка загрузки</h4>
                <p>@errorMessage</p>
            </div>
    }
    else if (isLoading)
    {
            <div class="alert alert-info shadow-sm">
                <div class="spinner-border spinner-border-sm me-2"></div>
                Загрузка аналитики...
            </div>
    }
    else
    {
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span>Опытные врачи</span>
                            <span class="badge bg-light text-primary">@experiencedDoctors.Count</span>
                        </div>
                        <div class="card-body p-0 short-card">
                            <ul class="list-group list-group-flush">
                            @foreach (var doc in experiencedDoctors)
                            {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>@doc.FullName</span>
                                            <span class="badge bg-info text-dark rounded-pill">@doc.ExperienceYears лет</span>
                                        </li>
                            }
                            @if (experiencedDoctors.Count == 0)
                            {
                                        <li class="list-group-item text-muted text-center py-3">Нет данных</li>
                            }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-success">
                        <div class="card-header bg-success text-white">
                            Повторные приемы
                        </div>
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                            <h1 class="display-1 fw-bold text-success mb-0">@followUpsCount</h1>
                            <p class="text-muted">Пациентов вернулись</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm border-warning">
                        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                            <span>Пациенты >30 лет</span>

                            <div class="d-flex align-items-center">
                                <label class="me-2 small fw-bold">На дату:</label>
                                <input type="date" class="form-control form-control-sm" 
                                       style="width: 140px;"
                                       value="@selectedDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnDateChanged" />
                            </div>
                        </div>
                        <div class="card-body p-0 short-card">
                            <table class="table table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>ФИО</th>
                                        <th>Телефон</th>
                                        <th>Год рожд.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in complexPatients)
                                {
                                            <tr>
                                                <td>@p.FullName</td>
                                                <td>@p.Phone</td>
                                                <td>@p.BirthDate.Year</td>
                                            </tr>
                                }
                                @if (complexPatients.Count == 0)
                                {
                                            <tr><td colspan="3" class="text-center text-muted">Нет данных</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm border-info">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <span>Расписание кабинета</span>

                            <div class="d-flex align-items-center">
                                <input type="text" class="form-control form-control-sm text-center fw-bold" 
                                       style="width: 80px;"
                                       value="@selectedRoom"
                                       @onchange="OnRoomChanged" 
                                       placeholder="№" />
                            </div>
                        </div>
                        <div class="card-body p-0 short-card">
                            <table class="table table-striped mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Время</th>
                                        <th>Врач ID</th>
                                        <th>Пациент ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var appt in roomSchedule)
                                {
                                            <tr>
                                                <td>@appt.StartAt</td>
                                                <td>@appt.DoctorId</td>
                                                <td>@appt.PatientId</td>
                                            </tr>
                                }
                                @if (roomSchedule.Count == 0)
                                {
                                            <tr><td colspan="3" class="text-center text-muted">Нет записей для кабинета @selectedRoom</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>

@code {
    private List<DoctorDto> experiencedDoctors = [];
    private List<PatientDto> complexPatients = [];
    private List<AppointmentDto> roomSchedule = [];
    private int followUpsCount = 0;

    private DateTime selectedDate = DateTime.Today;
    private string selectedRoom = "101";

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var t1 = Api.GetExperiencedDoctorsAsync();
            var t2 = Api.GetFollowUpsCountAsync();
            var t3 = Api.GetComplexPatientsAsync(selectedDate); 
            var t4 = Api.GetRoomScheduleAsync(selectedRoom);    

            await Task.WhenAll(t1, t2, t3, t4);

            experiencedDoctors = t1.Result;
            followUpsCount = t2.Result;
            complexPatients = t3.Result;
            roomSchedule = t4.Result;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить данные дашборда: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            selectedDate = newDate;
            try
            {
                complexPatients = await Api.GetComplexPatientsAsync(selectedDate);
            }
            catch (Exception ex) { errorMessage = ex.Message; }
        }
    }

    private async Task OnRoomChanged(ChangeEventArgs e)
    {
        var newRoom = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(newRoom))
        {
            selectedRoom = newRoom;
            try
            {
                roomSchedule = await Api.GetRoomScheduleAsync(selectedRoom);
            }
            catch (Exception ex) { errorMessage = ex.Message; }
        }
    }
}