@page "/appointments"
@using Hospital.Application.Contracts.Appointments
@using Hospital.Application.Contracts.Doctors
@using Hospital.Application.Contracts.Patients
@using System.ComponentModel.DataAnnotations
@inject HospitalApiClient Api

@rendermode InteractiveServer
@attribute [StreamRendering]

<PageTitle>Записи на прием</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Записи на прием</h1>
        <button class="btn btn-primary shadow-sm" @onclick="OpenCreateModal">
            <i class="bi bi-calendar-plus"></i> Новая запись
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Ошибка:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
    }

    @if (isLoading)
    {
            <div class="alert alert-info">
                <div class="spinner-border spinner-border-sm me-2"></div> Загрузка данных...
            </div>
    }
    else
    {
            <div class="table-scroll-container">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Время</th>
                            <th>Кабинет</th>
                            <th>Врач</th>
                            <th>Пациент</th>
                            <th>Тип</th>
                            <th style="width: 120px;" class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in appointments)
                    {
                                <tr>
                                    <td>@(item.StartAt.HasValue ? item.StartAt.Value.ToString("g") : "N/A")</td>
                                    <td>@item.RoomNumber</td>
                                    <td>@GetDoctorName(item.DoctorId)</td>
                                    <td>@GetPatientName(item.PatientId)</td>
                                    <td>
                                @if (item.IsFollowUp)
                                {
                                                <span class="badge bg-warning text-dark">Повторный</span>
                                }
                                else
                                {
                                                <span class="badge bg-success">Первичный</span>
                                }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAppointment(item.DoctorId)" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-muted small">Всего записей: @appointments.Count</div>
    }
</div>

@if (showModal)
{
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditMode ? "Изменить запись" : "Новая запись")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>

                    <div class="modal-body">
                        <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Время начала</label>
                                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="formModel.StartAt" />
                                <ValidationMessage For="() => formModel.StartAt" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Кабинет</label>
                                <InputText class="form-control" @bind-Value="formModel.RoomNumber" />
                                <ValidationMessage For="() => formModel.RoomNumber" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Врач</label>
                                <InputSelect class="form-select" @bind-Value="formModel.DoctorId">
                                    <option value="0">-- Выберите врача --</option>
                                @foreach (var doc in doctors)
                                {
                                            <option value="@doc.Id">@doc.FullName (@doc.Specialization)</option>
                                }
                                </InputSelect>
                                <ValidationMessage For="() => formModel.DoctorId" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Пациент</label>
                                <InputSelect class="form-select" @bind-Value="formModel.PatientId">
                                    <option value="0">-- Выберите пациента --</option>
                                @foreach (var p in patients)
                                {
                                            <option value="@p.Id">@p.FullName</option>
                                }
                                </InputSelect>
                                <ValidationMessage For="() => formModel.PatientId" />
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="formModel.IsFollowUp" id="chkFollowUp" />
                                <label class="form-check-label" for="chkFollowUp">Повторный прием?</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Сохранить</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
}

@code {
    private List<AppointmentDto> appointments = [];
    private List<DoctorDto> doctors = [];
    private List<PatientDto> patients = [];

    private bool isLoading = true;
    private string? errorMessage;
    private bool showModal = false;
    private bool isEditMode = false;
    private AppointmentDto? originalAppointment;

    public class AppointmentFormModel
    {
        public DateTime StartAt { get; set; } = DateTime.Now.AddHours(1);
        [Required] public string RoomNumber { get; set; } = "101";
        public bool IsFollowUp { get; set; } = false;
        [Range(1, int.MaxValue, ErrorMessage = "Выберите врача")] public int DoctorId { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "Выберите пациента")] public int PatientId { get; set; }
    }

    private AppointmentFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            var t1 = Api.GetAppointmentsAsync();
            var t2 = Api.GetDoctorsAsync();
            var t3 = Api.GetPatientsAsync();
            await Task.WhenAll(t1, t2, t3);

            appointments = t1.Result;
            doctors = t2.Result;
            patients = t3.Result;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally { isLoading = false; }
    }

    private string GetDoctorName(int id) => doctors.FirstOrDefault(d => d.Id == id)?.FullName ?? $"ID: {id}";
    private string GetPatientName(int id) => patients.FirstOrDefault(p => p.Id == id)?.FullName ?? $"ID: {id}";

    private void OpenCreateModal()
    {
        isEditMode = false;
        formModel = new AppointmentFormModel();
        showModal = true;
    }

    private void OpenEditModal(AppointmentDto appt)
    {
        isEditMode = true;
        originalAppointment = appt;

        formModel = new AppointmentFormModel
            {
                StartAt = appt.StartAt ?? DateTime.Now,
                RoomNumber = appt.RoomNumber,
                IsFollowUp = appt.IsFollowUp,
                DoctorId = appt.DoctorId,
                PatientId = appt.PatientId
            };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        showModal = false;
        await Task.CompletedTask;
    }

    private async Task DeleteAppointment(int id)
    {
        await Task.CompletedTask;
    }
}